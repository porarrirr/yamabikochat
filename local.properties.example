# This file contains machine/user-specific settings for the Android SDK.
# Copy this file to local.properties and edit for your machine.
# NEVER commit local.properties to version control
sdk.dir=/path/to/Android/Sdk

# Release signing configuration (optional; required for real release signing)
# Provide via local.properties, Gradle properties (-P...), or environment variables
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=YOUR_KEY_PASSWORD_HERE
RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=YOUR_KEYSTORE_PASSWORD_HERE

# Gemini OAuth (required for Gemini Auth login)
GEMINI_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID_HERE
GEMINI_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET_HERE
