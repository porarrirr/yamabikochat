{
  "name": "yamabiko-pi-runtime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --platform=node --format=esm --target=node24 --banner:js=\"import{createRequire as __yamabikoCreateRequire}from'node:module';const require=__yamabikoCreateRequire(import.meta.url);\" --outfile=bundle/main.js",
    "check": "node --check src/main.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "pi-grok": "https://github.com/stnly/pi-grok/archive/8b304e65c088f84ccb932959d97739245fe47d97.tar.gz",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
